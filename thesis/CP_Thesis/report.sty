% Page Border Setting (Double-Line Border)
\usepackage{tikz}
\usepackage{eso-pic}

% Border settings
\newlength{\borderthickness}
\setlength{\borderthickness}{1pt}  % Line thickness
\newlength{\bordergap}
\setlength{\bordergap}{2pt}       % Reduced gap between lines (was 4pt)

% Asymmetric border distances
\newlength{\borderleft}
\setlength{\borderleft}{1in}   % Left border offset (for binding)
\newlength{\borderother}
\setlength{\borderother}{0.5in}    % Other sides offset

\AddToShipoutPictureBG{%
\begin{tikzpicture}[remember picture, overlay]
    % Outer border line
    \draw[line width=\borderthickness] 
        ([shift={(\borderleft,-\borderother)}]current page.north west) rectangle 
        ([shift={(-\borderother,\borderother)}]current page.south east);
    % Inner border line (closer now)
    \draw[line width=\borderthickness] 
        ([shift={(\borderleft+\bordergap,-\borderother-\bordergap)}]current page.north west) rectangle 
        ([shift={(-\borderother-\bordergap,\borderother+\bordergap)}]current page.south east);
\end{tikzpicture}%
}

